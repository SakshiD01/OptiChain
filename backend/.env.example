# Copy to .env and fill in values as needed:
#   cp .env.example .env
#
# Local default: leave DATABASE_URL unset to use SQLite at backend/optichain.db

# Neon / Postgres (optional for local; required for production DB)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Comma-separated browser origins allowed by CORS (in addition to localhost:3000)
# CORS_ORIGINS=https://your-frontend.vercel.app

# Port used by the container / Render (uvicorn binds via process manager)
# PORT=8000
